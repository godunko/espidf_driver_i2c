with "config/espidf_driver_i2c_config.gpr";

with "a0b_common.gpr";

library project ESPIDF_Driver_I2C is

   for Library_Name use "ada_espidf_driver_i2c";
   for Library_Dir use ".libs/" & A0B_Common.Library_Dir_Suffix;
   for Languages use ("Ada", "C");
   for Object_Dir use ".objs/" & A0B_Common.Object_Dir_Suffix;
   for Source_Dirs use ("source");

   package Compiler is
      for Switches ("Ada") use A0B_Common.Compiler_Switches_Ada;
   end Compiler;

end ESPIDF_Driver_I2C;
